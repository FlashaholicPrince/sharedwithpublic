  "paths": {
    "/movies/{id}": {
      "get": {
        "summary": "Get Movies by CID",
        "description": "This resources fetches movies data based on the unique **character id** sent in the URI Parameter",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "MARVEL0001"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "If **character id** exists, returns the movies data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
